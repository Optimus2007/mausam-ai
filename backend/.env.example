# Copy to backend/.env and fill in. Never commit the real .env file.

# OpenWeather API key (https://home.openweathermap.org/api_keys). Leave empty for demo mode.
OPENWEATHER_API_KEY=

# auto  = try One Call 3.0 (hourly, UV, official alerts), fall back to free 2.5 endpoints
# false = always use the free 2.5 endpoints
OPENWEATHER_ONECALL=auto

# Force labelled sample data even if a key is set
DEMO_MODE=false

# Comma-separated origins allowed to call the API (add your GitHub Pages URL if you use it)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seconds to cache weather per location
WEATHER_CACHE_TTL=600

# Per-IP request limit for /api/* (0 disables)
RATE_LIMIT_PER_MINUTE=90
